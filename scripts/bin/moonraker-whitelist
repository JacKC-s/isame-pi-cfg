#!/usr/bin/env bash
# Add exact IPv4 client addresses to Moonraker's trusted_clients list.
set -euo pipefail

CONFIG=/home/pi4-software/printer_data/config/moonraker.conf
SERVICE=moonraker.service

if (( EUID != 0 )); then
  exec sudo -- "$0" "$@"
fi

if [[ ! -f "$CONFIG" ]]; then
  printf 'Moonraker configuration was not found: %s\n' "$CONFIG" >&2
  exit 1
fi

is_ipv4() {
  local ip=$1 octet
  [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS=. read -r -a octets <<< "$ip"
  for octet in "${octets[@]}"; do
    (( 10#$octet <= 255 )) || return 1
  done
}

show_clients() {
  awk '
    /^trusted_clients:[[:space:]]*$/ { showing=1; next }
    showing && /^[^[:space:]#][^:]*:/ { exit }
    showing && /^[[:space:]]*[^#[:space:]]/ { gsub(/^[[:space:]]+/, ""); print "  " $0 }
  ' "$CONFIG"
}

clear
printf '%s\n' '╔══════════════════════════════════════╗'
printf '%s\n' '║       Moonraker IP Whitelist         ║'
printf '%s\n' '╚══════════════════════════════════════╝'
printf '\nCurrent trusted clients:\n'
show_clients
printf '\nEnter an IPv4 address to whitelist (blank to cancel): '
read -r ip

if [[ -z $ip ]]; then
  printf 'No changes made.\n'
  exit 0
fi
if ! is_ipv4 "$ip"; then
  printf 'Invalid IPv4 address: %s\n' "$ip" >&2
  exit 2
fi
if awk -v ip="$ip" '$0 ~ "^[[:space:]]*" ip "[[:space:]]*$" { found=1 } END { exit !found }' "$CONFIG"; then
  printf '%s is already trusted; no changes made.\n' "$ip"
  exit 0
fi

printf 'Add %s and restart Moonraker? [y/N] ' "$ip"
read -r answer
if [[ ! $answer =~ ^[Yy]([Ee][Ss])?$ ]]; then
  printf 'No changes made.\n'
  exit 0
fi

backup="${CONFIG}.bak.$(date +%Y%m%d-%H%M%S)"
temp=$(mktemp "${CONFIG}.tmp.XXXXXX")
trap 'rm -f "$temp"' EXIT
cp --preserve=mode,ownership,timestamps "$CONFIG" "$backup"
awk -v ip="$ip" '
  /^trusted_clients:[[:space:]]*$/ { print; print "    " ip; next }
  { print }
' "$CONFIG" > "$temp"
install -o pi4-software -g pi4-software -m 664 "$temp" "$CONFIG"
systemctl restart "$SERVICE"

printf '\nSuccess: %s added to Moonraker trusted_clients.\nBackup: %s\n' "$ip" "$backup"
